<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- =====================================================
         개발 환경 (default / local 프로파일)
         콘솔에만 출력. 색상과 패턴을 가독성 좋게 설정.
         ===================================================== -->
    <springProfile name="default,local">

        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <!-- %highlight: 레벨별 색상, %cyan: 로거명 파란색 -->
                <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <!-- 프로젝트 코드는 DEBUG까지 출력 (SQL 포함) -->
        <logger name="com.church.website" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.springframework.security" level="INFO"/>

    </springProfile>

    <!-- =====================================================
         운영 환경 (prod 프로파일)
         콘솔 + 파일 동시 출력. 날짜/크기 기준 롤링.
         ===================================================== -->
    <springProfile name="prod">

        <!-- 콘솔 출력 (systemd journalctl 등으로 실시간 확인용) -->
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <!-- 파일 출력 — 날짜 + 크기 기준 롤링 -->
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <!-- logging.file.name 값과 일치시킴 -->
            <file>/var/log/church/app.log</file>

            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <!-- 매일 자정 + 50MB 초과 시 새 파일로 전환. gz 압축 보관. -->
                <fileNamePattern>/var/log/church/app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <!-- 30일 지난 파일 자동 삭제 -->
                <maxHistory>30</maxHistory>
                <!-- 전체 합계 1GB 초과 시 가장 오래된 파일부터 삭제 -->
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>

            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

        <!-- 프로젝트 코드는 INFO (운영에서 DEBUG·SQL은 과도한 노이즈) -->
        <logger name="com.church.website" level="INFO"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.springframework.security" level="WARN"/>

    </springProfile>

</configuration>
